<%# Expects: name, verifyLink %>
<div style="background:#F7FAFD; padding:32px 16px; font-family:Arial, Helvetica, sans-serif;">
  <div style="max-width:480px; margin:0 auto; background:#FFFFFF; border-radius:14px; overflow:hidden; border:1px solid #E3E9F0;">

    <%- include('_header') %>

    <div style="padding:32px 28px;">
      <p style="font-size:16px; color:#212529; margin:0 0 16px;">Hi <%= name.split(' ')[0] %>,</p>

      <p style="font-size:15px; color:#212529; line-height:1.6; margin:0 0 24px;">
        Tap the button below to verify your email and unlock proposing and accepting
        trades on Campus Barter.
      </p>

      <%- include('_button', { href: verifyLink, label: 'Verify my email' }) %>
    </div>

    <%- include('_footer') %>
  </div>
</div>